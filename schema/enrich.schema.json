{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wilianyichen/docxreport/schema/enrich.schema.json",
  "title": "docxreport enrich config",
  "description": "Config consumed by `enrich`, `validate`, `preview`.",
  "type": "object",
  "required": ["actions"],
  "properties": {
    "name": { "type": "string" },
    "output": { "type": "string", "description": "Optional; defaults to overwriting the input document. Relative to this config file." },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "action": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "add_page_break",
            "append_heading",
            "append_paragraph",
            "append_code_lines",
            "append_code_from_file",
            "append_image",
            "insert_image_after_anchor"
          ]
        },
        "text": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 9 },
        "anchor": { "type": "string", "description": "Body-level paragraph text to insert after." },
        "image": { "type": "string" },
        "caption": { "type": "string" },
        "width_inches": { "type": "number", "exclusiveMinimum": 0 },
        "file": { "type": "string" },
        "head_lines": { "type": "integer", "minimum": 1 },
        "tab_columns": { "type": "integer", "minimum": 1 },
        "lines": { "type": "array", "items": { "type": "string" } },
        "skip": { "type": "integer", "minimum": 0, "description": "Skip N earlier matches of the anchor." },
        "required": { "type": "boolean", "default": true }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "insert_image_after_anchor" } }, "required": ["action"] },
          "then": { "required": ["anchor", "image"] }
        },
        {
          "if": { "properties": { "action": { "const": "append_image" } }, "required": ["action"] },
          "then": { "required": ["image"] }
        },
        {
          "if": { "properties": { "action": { "const": "append_code_from_file" } }, "required": ["action"] },
          "then": { "required": ["file"] }
        },
        {
          "if": { "properties": { "action": { "const": "append_code_lines" } }, "required": ["action"] },
          "then": { "required": ["lines"] }
        },
        {
          "if": { "properties": { "action": { "const": "append_heading" } }, "required": ["action"] },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "action": { "const": "append_paragraph" } }, "required": ["action"] },
          "then": { "required": ["text"] }
        }
      ]
    }
  }
}
