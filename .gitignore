# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Test / build artifacts (generated at runtime, never committed)
# The template fixture is built on demand by tests/fixtures/build_fixture_template.py,
# so no .docx is ever tracked.
tests/fixtures/generated/
tests/tmp/
_tmp/
*.docx
*.doc
*.pdf

# examples/run_all.py writes to <example>/out/ and <example>/<sub>/out/
examples/**/out/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Local overrides
*.local.yml
